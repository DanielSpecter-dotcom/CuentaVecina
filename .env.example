# Copiar como .env.local (no se sube a git: *.local está en .gitignore)
# Supabase → Project Settings → API Keys. La publishable key es pública y está protegida por RLS.
# NUNCA poner aquí la secret key / service_role.
VITE_SUPABASE_URL=https://<ref-del-proyecto>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<clave>

# Notificaciones push (opcional). Llave PÚBLICA VAPID; la privada va solo como secret de Supabase.
# Generar el par con: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
