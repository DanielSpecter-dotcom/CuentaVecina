# .npmrc del proyecto CuentaVecina (se sube a git, va en la raiz del proyecto junto a package.json)
# Requiere npm >= 11.10: las versiones antiguas ignoran estas opciones SIN avisar.

# No ejecutar scripts de instalacion (preinstall/install/postinstall) de las dependencias.
# Es la via por la que entran casi todos los ataques a la cadena de suministro.
ignore-scripts=true

# No instalar versiones publicadas hace menos de 3 dias.
# Los paquetes infectados suelen detectarse y retirarse en horas.
min-release-age=3

# No permitir dependencias desde repositorios git (pueden ejecutar codigo aunque ignore-scripts este activo).
allow-git=none

# Guardar versiones exactas (sin ^) al agregar paquetes: todos tienen exactamente lo mismo.
save-exact=true

# npm audit falla solo con vulnerabilidades altas o criticas.
audit-level=high

# Solo el registro oficial.
registry=https://registry.npmjs.org/

fund=false
